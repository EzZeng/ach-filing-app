# GN args for a portable-friendly Chromium release build on Windows.
# Usage (from chromium/src):
#   gn gen out\Portable --args="$(Get-Content ..\..\ach-filing-app\tools\chromium-windows-portable\args.gn -Raw)"
# Or paste into: gn args out\Portable
#
# Reference:
# https://chromium.googlesource.com/chromium/src/+/main/docs/windows_build_instructions.md

is_debug = false
is_component_build = false
is_official_build = true
symbol_level = 0
blink_symbol_level = 0
v8_symbol_level = 0
enable_nacl = false
# Match host by default; set explicitly if cross-building:
# target_cpu = "x64"
